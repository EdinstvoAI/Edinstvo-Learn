# Generate each secret separately with: openssl rand -hex 32
POSTGRES_PASSWORD=
LOCAL_SETUP_TOKEN=
ACCESS_CODE_SECRET=
LOCAL_MENTOR_NAME=Макар
LEARN_PORT=5188

# Production uses Telegram credentials and an HTTPS origin. Leave LOCAL_SETUP_TOKEN empty.
# TELEGRAM_MENTOR_ID is your numeric Telegram user ID. See docs/DEPLOY.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MENTOR_ID=
PUBLIC_ORIGIN=

# Optional hidden mentor sign-in from a browser: hold the logo for 10 seconds, then email, password and PIN.
# Hashes come from: npm run mentor:hash (run once for the password and once for the 4-8 digit PIN).
MENTOR_EMAIL=
MENTOR_PASSWORD_HASH=
MENTOR_PIN_HASH=
