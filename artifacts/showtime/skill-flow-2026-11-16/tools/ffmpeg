#!/bin/bash
# FFmpeg 8.1 removed the legacy -vsync option used by the tap audit.
args=()
while (($#)); do
  if [[ "$1" == -vsync && "${2:-}" == 0 ]]; then
    args+=(-fps_mode passthrough)
    shift 2
  elif [[ "$1" == -filter_complex && "${2:-}" == *'gblur=sigma=42:steps=3[softscene]'* ]]; then
    graph="$2"
    if [[ "$graph" =~ between\(n,([0-9]+),([0-9]+)\).*between\(n,([0-9]+),([0-9]+)\) ]]; then
      active="between(n,${BASH_REMATCH[1]},${BASH_REMATCH[2]})+between(n,${BASH_REMATCH[3]},${BASH_REMATCH[4]})"
      graph="${graph/gblur=sigma=42:steps=3\[softscene\]/gblur=sigma=42:steps=3:enable='$active'[softscene]}"
    fi
    args+=("$1" "$graph")
    shift 2
  else
    args+=("$1")
    shift
  fi
done
exec /opt/homebrew/bin/ffmpeg "${args[@]}"
